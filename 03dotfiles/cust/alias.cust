##############################################
# SSH
##############################################
# ensure pseudo-terminal. To allow any additional confirm prompt from executing command
# ex: ssh -t user@remote_server "sudo apt update"
alias ssht='ssh -t'
check_ssh_tunnel(){
    echo "==== internet socket files"
    lsof -i -n -P | grep ssh | grep LISTEN
    # -i: internet socket files
    # -n: host ip instead name
    # -P: port number instead name
    echo

    echo "==== ssh listen port"
    ss -ntlp | grep ssh
    echo

    echo "==== command"
    ps -ef | grep ssh | grep -E "\-L|\-R|\-D"
    echo
}


