##############################################
# HIGHLIGHT LINE
##############################################
# USAGE:
# $ tail -F /var/log/syslog | hh
# $ cat /var/log/syslog | hh

function hh() {
    sed -u \
    -e "s/\(\b[0-9]\+\b\)/\o033[1;92m\1\o033[0;m/gi" \
    -e "s/\(\bexception\w*\b\)/\o033[1;31m\1\o033[0;m/gi" \
    -e "s/\(\bemerg\w*\b\)/\o033[1;31m\1\o033[0;m/gi" \
    -e "s/\(\balert\w*\b\)/\o033[1;31m\1\o033[0;m/gi" \
    -e "s/\(\bcritical\w*\b\)/\o033[1;31m\1\o033[0;m/gi" \
    -e "s/\(\berror\w*\b\)/\o033[1;31m\1\o033[0;m/gi" \
    -e "s/\(\bcause\w*\b\)/\o033[1;31m\1\o033[0;m/gi" \
    -e "s/\(\bwarn\w*\)/\o033[1;33m\1\o033[0;m/gi" \
    -e "s/\(\bnotice\w*\b\)/\o033[1;33m\1\o033[0;m/gi" \
    -e "s/\(\binfo\w*\b\)/\o033[1;33m\1\o033[0;m/gi" \
    -e "s/\(\bdebug\w*\b\)/\o033[1;33m\1\o033[0;m/gi" \
    -e "s/\(\bsuccess\w*\b\)/\o033[1;42m\1\o033[0;m/gi" \
    -e "s/\(\bfail\w*\b\)/\o033[1;41m\1\o033[0;m/gi" \
    -e "s/\(\btrue\w*\b\)/\o033[1;46m\1\o033[0;m/gi" \
    -e "s/\(\bfalse\w*\b\)/\o033[1;46m\1\o033[0;m/gi" \
    -e "s/\(\bstart\w*\b\)/\o033[1;46m\1\o033[0;m/gi" \
    -e "s/\(\bstop\w*\b\)/\o033[1;46m\1\o033[0;m/gi" \
    -e "s/\(\benable\w*\b\)/\o033[1;46m\1\o033[0;m/gi" \
    -e "s/\(\bdisable\w*\b\)/\o033[1;46m\1\o033[0;m/gi" \
    -e "s/\(\bswtest\w*\b\)/\o033[1;37;101m\1\o033[0;m/gi"
}

# USAGE:
# $ cat myfile | hhh make
function hhh() {
    sed -u -e "s/\($1\)/\o033[1;6;30;103m\1\o033[0;m/gi"
}

# USAGE:
# $ tailf myfile
function tailf() {
    tail -f $1 | hh
}

function tailfgrep() {
    tail -f $1 | hh | grep $2
}

# USAGE:
# $ tailF myfile
function tailF() {
    tail -F $1 | hh
}

function tailFgrep() {
    tail -F $1 | hh | grep $2
}

# USAGE:
# $ cats myfile
function cats() {
    cat $1 | hh
}


##############################################
# fzf
##############################################
# change directory using fzf
alias fcd='cd $(fd --type d --hidden --exclude .git | fzf)'

# ff - find files and print list
ff() {
    # 1. 입력받은 경로 설정 (인자가 없으면 현재 디렉토리 '.' 사용)
    local search_path="${1:-.}"

    # [추가] 존재하지 않는 경로이거나 디렉토리가 아니면 경고 후 종료
    if [ ! -e "$search_path" ]; then
        echo "Error: '$search_path' 경로가 존재하지 않습니다." >&2
        return 1
    elif [ ! -d "$search_path" ]; then
        echo "Error: '$search_path'는 디렉토리가 아닙니다." >&2
        return 1
    fi

    # 2. bat 또는 cat 미리보기 명령어 세팅
    local preview_cmd="cat {}"
    if command -v bat &>/dev/null; then
        preview_cmd="bat --style=numbers --color=always --line-range :500 {}"
    fi

    # 3. 파일 목록 생성 방식 결정 (fd가 있으면 fd, 없으면 find)
    local list_cmd
    if command -v fd &>/dev/null; then
        list_cmd="fd --type file . \"$search_path\""
    elif command -v fde &>/dev/null; then
        list_cmd="fde --type file . \"$search_path\""
    else
        list_cmd="find \"$search_path\" -type f"
    fi

    # 4. 검증된 임시 파일 방식 실행
    local tmp_file
    tmp_file=$(mktemp)

    # 목록 명령어를 실행하여 fzf로 전달
    eval "$list_cmd" | fzf -m --marker='▶ ' --preview "$preview_cmd" > "$tmp_file"

    # 5. fzf 종료 후 선택한 파일 리스트가 있으면 프롬프트에 나열
    if [ -s "$tmp_file" ]; then
        cat "$tmp_file"
    fi

    # 임시 파일 삭제
    rm -f "$tmp_file"
}


# fe - Find files and open them in Vim
fe() {
    local file
    local preview_cmd

    # 1. 구문 강조 도구(batcat 또는 bat) 확인
    if command -v batcat >/dev/null 2>&1; then
        preview_cmd='batcat --style=numbers --color=always --line-range :500 {}'
    elif command -v bat >/dev/null 2>&1; then
        preview_cmd='bat --style=numbers --color=always --line-range :500 {}'
    else
        preview_cmd='cat {}'
    fi

    # 2. fd 설치 여부에 따라 파일 목록 생성 및 fzf 실행
    if command -v fd >/dev/null 2>&1; then
        file=$(fd --type f --hidden --exclude .git . | fzf --preview "$preview_cmd")
    else
        file=$(fzf --preview "$preview_cmd" .)
    fi

    # 3. 파일이 정상 선택되었을 때만 에디터 실행
    [ -n "$file" ] && "${EDITOR:-vim}" "$file"
}

# fat - cat file
fat() {
    local file
    local preview_cmd

    # 1. 구문 강조 도구(batcat 또는 bat) 확인
    if command -v batcat >/dev/null 2>&1; then
        preview_cmd='batcat --style=numbers --color=always --line-range :500 {}'
    elif command -v bat >/dev/null 2>&1; then
        preview_cmd='bat --style=numbers --color=always --line-range :500 {}'
    else
        preview_cmd='cat {}'
    fi

    # 2. fd 설치 여부에 따라 파일 목록 생성 및 fzf 실행
    if command -v fd >/dev/null 2>&1; then
        file=$(fd --type f --hidden --exclude .git . | fzf --preview "$preview_cmd")
    else
        file=$(fzf --preview "$preview_cmd" .)
    fi

    # run vim when only files are selected (cancel allowed by ESC)
    [ -n "$file" ] && batcat --style=header "$file"
}

# frm - Remove files
frm() {
    local files
    files=$(fd --type f | fzf -m)

    # Only run rm if files were actually selected
    if [ -n "$files" ]; then
        # Safe execution via xargs with TTY enabled
        echo "$files" | xargs -ro -d '\n' rm -i
    fi
}


