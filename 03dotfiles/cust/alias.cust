##############################################
# TCPDUMP
##############################################
# USAGE: $ tdump "host 1.2.3.4 and port 8080"
function tdump() {
    sudo tcpdump -U -i eno1 $1 -w - | tee "tcpdump.$(date +%Y%m%d-%H%M%S).pcap" | tcpdump -qns 0 -A -r -
}


