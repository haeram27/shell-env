############################################## 
# findn: name-specific
# USAGE: $ findn . "*cust"
function findn() {
    find "$1" -name "$2" 2>/dev/null
}

# findl: follow symboliclink
function findl() {
    find -L "$1" -name "$2" 2>/dev/null
}


