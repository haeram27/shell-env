##############################################
# CHMOD 
##############################################
chmodall() {
    find . -type f \( -name "*.txt" -o -name "*.tgz" -o -name "*.tar.gz" -o -name "*.txz" \) -exec chmod 644 {} \;
    find . -type f -name "*.sh" -exec chmod 755 {} \;
    find . -type d -exec chmod 775 {} \;
}

chmodsh() {
    find . -type f -name "*.sh" -exec chmod 755 {} \;
}

chmoddir() {
    find . -type d -exec chmod 775 {} \;
}


##############################################
# COPY AND MOVE
##############################################
ensure-dir-slash() {
    local dir="$1"

    # 1. Check if the variable is not empty (-n: string length is non-zero)
    if [[ -n "$dir" ]]; then
        # 2. Squeeze multiple slashes (e.g., //, ///) into a single slash (/)
        dir=$(echo "$dir" | tr -s '/')

        # 3. Remove trailing slash if exists, then append exactly one slash
        dir="${dir%/}/"

        echo -n "$dir"
    fi
}

copyd() {
    for dir in "$1" "$2"; do
        if [ ! -d "$dir" ]; then
            echo "Directory NOT exists: $dir"
          return 1
        fi
    done

    if user_confirm "Do you want to overwrite files?"; then
        # cp -rf a/* b
        cp -rf $(ensure-dir-slash "$1")* "$2"
    else
        echo "cancelled."
    fi
}

syncd() {
    for dir in "$1" "$2"; do
        if [ ! -d "$dir" ]; then
            echo "Directory NOT exists: $dir"
          return 1
        fi
    done

    if user_confirm "Files can be removed in $2"; then
        # rsync -av --delete a/ b
        rsync -av --delete $(ensure-dir-slash "$1") "$2"
    else
        echo "cancelled."
    fi
}

##############################################
